<script>
setTimeout(() => {
  const successMessage = document.getElementById('success-message');
  if (successMessage) {
    successMessage.classList.add('transition-opacity', 'duration-1000', 'opacity-0');
    
    successMessage.addEventListener('transitionend', () => {
      successMessage.remove(); 
      window.location.href = "<?= WEB_ROOT ?>/tasks/list";
    });
  }

  const errorMessage = document.getElementById('error-message');
  if (errorMessage) {
    errorMessage.classList.add('transition-opacity', 'duration-1000', 'opacity-0');

    errorMessage.addEventListener('transitionend', () => {
      errorMessage.remove(); 
    });
  }
}, 1500);

</script>

<script>
  setTimeout(() => {
  const overlay = document.getElementById('loading-overlay');
  overlay.classList.remove('hidden');
  overlay.classList.add('flex');

  window.location.href = "<?= WEB_ROOT ?>/tasks/list";
}, 1500);


     


